# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Database (default: SQLite — change to PostgreSQL for server deployments)
# DATABASE_URL=sqlite:///muscle_power.db
# DATABASE_URL=postgresql://user:password@localhost:5432/muscle_power

# Sensor override (optional — leave blank to auto-select first found sensor)
# PREFERRED_SENSOR_ADDRESS=AA:BB:CC:DD:EE:FF
